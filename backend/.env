# CLPM backend environment variables (override defaults in config.yaml)

# ── TimescaleDB ──────────────────────────────────────────────
DATABASE_URL=postgresql://streampipes:streampipes@localhost:5432/streampipes

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OPC-UA (server/listen addresses can be overridden separately) ──
# value used by client side; point at your PLC or simulation host
OPCUA_REAL_ENDPOINT=opc.tcp://192.168.18.112:4840/clpm/server

# override the server bind address if you need something other than 0.0.0.0
OPCUA_SERVER_ENDPOINT=opc.tcp://0.0.0.0:4840/clpm/server

# ── API / JWT ────────────────────────────────────────────────
JWT_SECRET=change-this-in-production

# ── Superset (used by init_superset.sh) ───────────────────────
SUPERSET_URL=http://superset:8088
SUPERSET_ADMIN=admin
SUPERSET_PASSWORD=admin
# additional Superset vars pulled by the container but not by backend code
SUPERSET_SECRET_KEY=clpm-superset-secret-change-in-prod
SUPERSET_DB_URI=postgresql+psycopg2://superset:superset_pass@superset-db:5432/superset