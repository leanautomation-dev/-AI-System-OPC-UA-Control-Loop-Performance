# CLPM OPC-UA System environment variables
# Copy to .env and customise before running docker compose.

# ── TimescaleDB ──────────────────────────────────────────────
DATABASE_URL=postgresql://streampipes:streampipes@timescaledb:5432/streampipes

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── OPC-UA (set to your real PLC endpoint to go live) ────────
OPCUA_REAL_ENDPOINT=opc.tcp://opcua-server:4840/clpm/server
# OPCUA_REAL_ENDPOINT=opc.tcp://192.168.1.100:4840/UA/Server

# ── API ──────────────────────────────────────────────────────
JWT_SECRET=change-this-secret-in-production

# ── Superset ─────────────────────────────────────────────────
SUPERSET_URL=http://superset:8088
SUPERSET_ADMIN=admin
SUPERSET_PASSWORD=admin
SUPERSET_SECRET_KEY=clpm-superset-secret-change-in-prod
SUPERSET_DB_URI=postgresql+psycopg2://superset:superset_pass@superset-db:5432/superset
